{
  "name": "ai-portfolio-analytics-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Institutional AI Portfolio Analytics Agent with RACSE Engine",
  "scripts": {
    "agent:cli": "python_env\\python.exe cli.py -i",
